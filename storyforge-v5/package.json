{
  "name": "@missionmed/storyforge-v5",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/app.mjs",
    "build": "npm run build:development",
    "build:api": "node scripts/check-api-only-build.mjs",
    "build:development": "node scripts/check-canonical-authority.mjs && node scripts/build-static.mjs --mode=development && node scripts/check-product-provenance.mjs --mode=development",
    "build:release": "node scripts/assert-release-source.mjs --mode=release && node scripts/check-canonical-authority.mjs && node scripts/build-static.mjs --mode=release && node scripts/build-wordpress-route-manifest.mjs --mode=release && node scripts/check-product-provenance.mjs --mode=release",
    "check:canonical-authority": "node scripts/check-canonical-authority.mjs",
    "check:wp-route-manifest": "node scripts/assert-release-source.mjs --mode=release && node scripts/build-wordpress-route-manifest.mjs --mode=release --check",
    "scan:secrets": "node scripts/scan-bundle-secrets.mjs",
    "sync:identities": "node scripts/storyforge-identity-sync.mjs",
    "score:transcription-bakeoff": "node scripts/score-transcription-bakeoff.mjs",
    "survival:capture": "node scripts/sf-survival-manifest.mjs capture",
    "survival:compare": "node scripts/sf-survival-manifest.mjs compare",
    "test": "node --test tests/unit/*.test.mjs",
    "test:postgres": "bash scripts/run-postgres-tests.sh",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:integration": "bash scripts/run-integration.sh",
    "test:conformance": "npm run check:product-provenance && bash scripts/run-conformance.sh",
    "test:conformance:development": "npm run build:development && bash scripts/run-conformance.sh",
    "test:conformance:browser": "bash scripts/run-conformance.sh",
    "check:product-provenance": "node scripts/check-product-provenance.mjs --mode=release",
    "check:product-provenance:development": "node scripts/check-product-provenance.mjs --mode=development",
    "dev:db": "bash scripts/run-local.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "jose": "^6.0.12",
    "pg": "^8.16.3",
    "read-excel-file": "^9.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "axe-core": "^4.10.3",
    "fflate": "^0.8.2"
  }
}
