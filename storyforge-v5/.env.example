# Required runtime
STORYFORGE_DATABASE_URL=
STORYFORGE_HOST=0.0.0.0
STORYFORGE_PUBLIC_ORIGIN=https://missionmedinstitute.com
STORYFORGE_BASE_PATH=/storyforge/
STORYFORGE_MATRIX_BASE_URL=https://missionmedinstitute.com/member-dashboard/
STORYFORGE_WP_BOOTSTRAP_PATH=/wp-admin/admin-ajax.php?action=missionmed_storyforge_bootstrap
STORYFORGE_WP_TOKEN_PATH=/wp-json/missionmed/v1/storyforge/token
STORYFORGE_ALLOWED_ORIGINS=https://missionmedinstitute.com
STORYFORGE_TOKEN_REFRESH_SKEW_SECONDS=15
STORYFORGE_STATIC_DIR=dist
STORYFORGE_JWT_ISSUER=https://missionmedinstitute.com/wp-json/missionmed/v1/storyforge
STORYFORGE_JWT_AUDIENCE=storyforge

# Choose exactly one production verification mode.
STORYFORGE_JWKS_URL=
STORYFORGE_JWT_SECRET=

# Feature flags default closed.
STORYFORGE_AI_MENTOR_BETA=0
STORYFORGE_AI_STUDENT_GENERAL=0
STORYFORGE_AI_CLINICAL_MENTOR=0
STORYFORGE_AI_CLINICAL_STUDENT=0

# Independent administrator-workspace emergency kill switch. Missing or nonzero stays off.
STORYFORGE_ADMIN_CONSOLE_FORCE_OFF=1
STORYFORGE_PREMIUM_MOTION=0

# Private StoryForge audio storage. Do not point these at a public bucket.
STORYFORGE_R2_ENDPOINT=
STORYFORGE_R2_REGION=auto
STORYFORGE_R2_BUCKET=
STORYFORGE_R2_ACCESS_KEY_ID=
STORYFORGE_R2_SECRET_ACCESS_KEY=
STORYFORGE_R2_SIGNED_URL_TTL_SECONDS=300

# Transcription stays truthfully unavailable until the provider authority is amended.
STORYFORGE_TRANSCRIBE_PROVIDER=none

# Weekly permanent-audio reconciliation is disabled until its Founder-reviewed gates.
STORYFORGE_AUDIO_RECONCILIATION=off
# Any non-empty value suspends reconciliation before storage is touched.
STORYFORGE_AUDIO_RECONCILIATION_SUSPENDED=

# Local testing only. Production must never set this.
STORYFORGE_DEV_AUTH=0
STORYFORGE_DEV_JWT_SECRET=
