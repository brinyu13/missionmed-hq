# Required runtime
STORYFORGE_DATABASE_URL=
STORYFORGE_HOST=0.0.0.0
STORYFORGE_PUBLIC_ORIGIN=https://missionmedinstitute.com
STORYFORGE_JWT_ISSUER=https://missionmed-hq-production.up.railway.app
STORYFORGE_JWT_AUDIENCE=storyforge

# Choose exactly one production verification mode.
STORYFORGE_JWKS_URL=
STORYFORGE_JWT_SECRET=

# Feature flags default closed.
STORYFORGE_AI_MENTOR_BETA=0
STORYFORGE_AI_STUDENT_GENERAL=0
STORYFORGE_AI_CLINICAL_MENTOR=0
STORYFORGE_AI_CLINICAL_STUDENT=0

# Private StoryForge audio storage. Do not point these at a public bucket.
STORYFORGE_R2_ENDPOINT=
STORYFORGE_R2_REGION=auto
STORYFORGE_R2_BUCKET=
STORYFORGE_R2_ACCESS_KEY_ID=
STORYFORGE_R2_SECRET_ACCESS_KEY=
STORYFORGE_R2_SIGNED_URL_TTL_SECONDS=300

# Local testing only. Production must never set this.
STORYFORGE_DEV_AUTH=0
STORYFORGE_DEV_JWT_SECRET=
