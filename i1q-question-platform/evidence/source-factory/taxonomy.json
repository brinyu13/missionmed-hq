    ],
    "entries": [
      {
        "misconception_id": "misconception.diagnostic_sequence_error",
        "category": "diagnostic_sequence_error",
        "definition": "Selects a plausible diagnostic action in the wrong order."
      },
      {
        "misconception_id": "misconception.epidemiology_substitution",
        "category": "epidemiology_substitution",
        "definition": "Substitutes an exposure or population pattern that does not fit the case."
      },
      {
        "misconception_id": "misconception.finding_disease_mismatch",
        "category": "finding_disease_mismatch",
        "definition": "Maps a finding to a disease that does not account for the full pattern."
      },
      {
        "misconception_id": "misconception.mechanism_confusion",
        "category": "mechanism_confusion",
        "definition": "Uses an incorrect causal or physiologic mechanism."
      },
      {
        "misconception_id": "misconception.management_escalation_error",
        "category": "management_escalation_error",
        "definition": "Escalates, delays, or sequences management inappropriately."
      },
      {
        "misconception_id": "misconception.management_indication_error",
        "category": "management_indication_error",
        "definition": "Applies a treatment or intervention without the required indication."
      },
      {
        "misconception_id": "misconception.near_neighbor_diagnosis",
        "category": "near_neighbor_diagnosis",
        "definition": "Chooses a clinically adjacent diagnosis while missing a discriminating feature."
      },
      {
        "misconception_id": "misconception.screening_diagnostic_confusion",
        "category": "screening_diagnostic_confusion",
        "definition": "Confuses screening, confirmation, and definitive diagnostic testing."
      },
      {
        "misconception_id": "misconception.severity_threshold_error",
        "category": "severity_threshold_error",
        "definition": "Misapplies a severity, duration, or treatment threshold."
      },
      {
        "misconception_id": "misconception.temporal_pattern_error",
        "category": "temporal_pattern_error",
        "definition": "Misreads onset, duration, sequence, or timing."
      },
      {
        "misconception_id": "misconception.treatment_diagnosis_confusion",
        "category": "treatment_diagnosis_confusion",
        "definition": "Substitutes a treatment concept for the diagnosis or vice versa."
      }
    ]
  },
