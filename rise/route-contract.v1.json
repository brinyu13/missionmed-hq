{
  "schemaVersion": 1,
  "service": "missionmed-rise",
  "browserTopology": "same_origin_reverse_proxy",
  "publicOriginEnvironment": "RISE_PUBLIC_ORIGIN",
  "requiredPathMappings": [
    {
      "publicPrefix": "/rise",
      "servicePrefix": "/rise",
      "methods": ["GET", "HEAD"]
    },
    {
      "publicPrefix": "/vendor/lucide.js",
      "servicePrefix": "/vendor/lucide.js",
      "methods": ["GET", "HEAD"]
    },
    {
      "publicPrefix": "/api/rise/v1",
      "servicePrefix": "/api/rise/v1",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE"]
    }
  ],
  "browserApiUrls": "relative_same_origin_only",
  "cors": "disabled",
  "cookieRequirement": "The approved HQ session cookie must be scoped to the selected public origin and forwarded unchanged to the RISE service.",
  "edgeOwnerApprovalRequired": true,
  "currentActivationStatus": "unprovisioned"
}
