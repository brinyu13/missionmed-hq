{
  "name": "@missionmed/rise",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated MissionMed RISE registry service",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "sync:fable": "node tools/sync-fable-shell.mjs",
    "build": "npm run sync:fable && node tools/build-app.mjs",
    "start": "node server.mjs",
    "start:production": "node tools/start-production.mjs",
    "verify:railway-target": "node tools/assert-railway-project.mjs",
    "deploy:production": "npm run verify:railway-target && railway up --project c0113625-951e-46ab-939b-dd57acc0e87c --environment 549d6597-1962-44cb-b0f5-7d88bd025e31 --service 9bce2090-ce45-4572-8291-e8da5d42acb6 --detach --json --message P1-RISE-5006-remediated-release",
    "test": "node --test tests/*.test.mjs",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test --config playwright.config.mjs",
    "test:stress": "node tests/stress-synthetic.mjs"
  },
  "dependencies": {
    "lucide": "1.24.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "axe-core": "4.12.1",
    "exceljs": "4.4.0"
  },
  "overrides": {
    "brace-expansion@<=1.1.17": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "uuid": "11.1.1"
  }
}
