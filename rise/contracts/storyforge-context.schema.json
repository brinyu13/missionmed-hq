{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missionmedinstitute.com/contracts/rise/storyforge-context.v1.schema.json",
  "title": "Consent-bound StoryForge references for RISE",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "audience", "subject", "consentReceiptSha256", "referenceIds", "issuedAt", "expiresAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "audience": { "const": "rise" },
    "subject": { "type": "string", "minLength": 1, "maxLength": 256 },
    "consentReceiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "referenceIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" }
    },
    "issuedAt": { "type": "integer" },
    "expiresAt": { "type": "integer" }
  }
}
