{
  "name": "@missionmed/homebase-v1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/app.mjs",
    "build": "npm run build:api",
    "build:api": "node scripts/check-api-only-build.mjs",
    "build:development": "node scripts/build-static.mjs --mode=development",
    "build:release": "node scripts/assert-release-source.mjs --mode=release && node scripts/build-static.mjs --mode=release && node scripts/scan-release.mjs && node scripts/build-wordpress-route-manifest.mjs --mode=release",
    "check:wp-route-manifest": "node scripts/assert-release-source.mjs --mode=release && node scripts/build-wordpress-route-manifest.mjs --mode=release --check",
    "scan:release": "node scripts/scan-release.mjs",
    "test": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "jose": "^6.0.12",
    "pg": "^8.16.3"
  }
}
