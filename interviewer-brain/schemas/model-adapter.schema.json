{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "missionmed.model-adapter.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "adapter_id", "revision", "mode", "network_access", "provider", "retention_profile", "raw_output_persisted", "content_hash"],
  "properties": {
    "contract_version": { "const": "missionmed.model-adapter.v1" }, "adapter_id": { "type": "string" }, "revision": { "type": "integer", "minimum": 1 }, "mode": { "const": "deterministic_rule" },
    "network_access": { "const": false }, "provider": { "type": "null" }, "retention_profile": { "const": "none" }, "raw_output_persisted": { "const": false }, "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
