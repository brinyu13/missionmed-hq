{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "missionmed.interviewer-persona.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "persona_id", "revision", "display_name", "role", "pressure_rung", "warmth_directness_balance", "style", "boundaries", "probe_limits", "approved_grounding_sources", "voice_reference", "provenance", "content_hash"],
  "properties": {
    "contract_version": { "const": "missionmed.interviewer-persona.v1" },
    "persona_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "role": { "const": "residency_interviewer" },
    "pressure_rung": { "type": "integer", "minimum": 0, "maximum": 4 },
    "warmth_directness_balance": {
      "type": "object", "additionalProperties": false, "required": ["warmth", "directness"],
      "properties": { "warmth": { "type": "integer", "minimum": 0, "maximum": 4 }, "directness": { "type": "integer", "minimum": 0, "maximum": 4 } }
    },
    "style": {
      "type": "object", "additionalProperties": false, "required": ["tone", "pacing", "follow_up_style", "transition_style", "wrap_up_style"],
      "properties": {
        "tone": { "type": "string" }, "pacing": { "type": "string" }, "follow_up_style": { "type": "string" }, "transition_style": { "type": "string" }, "wrap_up_style": { "type": "string" }
      }
    },
    "boundaries": {
      "type": "object", "additionalProperties": false, "required": ["restricted_topics", "prohibited_inferences", "prohibited_behaviors"],
      "properties": {
        "restricted_topics": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "prohibited_inferences": { "type": "array", "minItems": 8, "items": { "type": "string" }, "uniqueItems": true },
        "prohibited_behaviors": { "type": "array", "minItems": 6, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "probe_limits": {
      "type": "object", "additionalProperties": false, "required": ["pressure_rungs_0_1", "pressure_rungs_2_plus"],
      "properties": { "pressure_rungs_0_1": { "const": 1 }, "pressure_rungs_2_plus": { "const": 2 } }
    },
    "approved_grounding_sources": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "enum": ["synthetic_answer", "synthetic_domain_pack", "synthetic_instructor_focus"] } },
    "voice_reference": { "type": "null" },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["source_type", "source_id", "source_version", "simulated"],
      "properties": { "source_type": { "const": "synthetic" }, "source_id": { "type": "string" }, "source_version": { "type": "string" }, "simulated": { "const": true } }
    },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
