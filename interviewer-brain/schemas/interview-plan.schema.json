{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "missionmed.interview-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plan_id", "revision", "title", "mode", "session_objective", "persona_ref", "duration_target_seconds", "total_probe_budget", "question_families", "required_coverage", "optional_coverage", "transition_conditions", "callback_opportunities", "wrap_up_criteria", "questions", "restricted_topics", "synthetic_only", "content_hash"],
  "properties": {
    "contract_version": { "const": "missionmed.interview-plan.v1" },
    "plan_id": { "type": "string" }, "revision": { "type": "integer", "minimum": 1 }, "title": { "type": "string" },
    "mode": { "const": "synthetic_text_phase0" }, "session_objective": { "type": "string" },
    "persona_ref": { "$ref": "#/$defs/versionedRef" },
    "duration_target_seconds": { "type": "integer", "minimum": 300, "maximum": 1800 },
    "total_probe_budget": { "type": "integer", "minimum": 1, "maximum": 80 },
    "question_families": { "$ref": "#/$defs/stringSet" }, "required_coverage": { "$ref": "#/$defs/stringSet" },
    "optional_coverage": { "$ref": "#/$defs/stringSet" }, "transition_conditions": { "$ref": "#/$defs/stringSet" },
    "callback_opportunities": { "$ref": "#/$defs/stringSet" }, "wrap_up_criteria": { "$ref": "#/$defs/stringSet" },
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["question_id", "prompt", "category", "pressure_rung", "focus_tags", "red_flag_boundary", "wrap_up"],
        "properties": {
          "question_id": { "type": "string" }, "prompt": { "type": "string" },
          "category": { "enum": ["behavioral", "situational", "context", "red_flag", "general"] },
          "pressure_rung": { "type": "integer", "minimum": 0, "maximum": 4 },
          "focus_tags": { "$ref": "#/$defs/stringSet" }, "red_flag_boundary": { "type": ["string", "null"] }, "wrap_up": { "type": "boolean" }
        }
      }
    },
    "restricted_topics": { "$ref": "#/$defs/stringSet" }, "synthetic_only": { "const": true },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "stringSet": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "versionedRef": {
      "type": "object", "additionalProperties": false, "required": ["persona_id", "revision", "content_hash"],
      "properties": { "persona_id": { "type": "string" }, "revision": { "type": "integer", "minimum": 1 }, "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    }
  }
}
