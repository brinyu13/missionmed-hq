 let expertFilter='All';function renderExperts(){const h=document.getElementById('experts');h.className='expert-index';document.getElementById('expertFilters')?.remove();h.insertAdjacentHTML('beforebegin',`<div id="expertFilters" class="expert-filters" role="group" aria-label="Filter expert reviews">${['All','Camera','Audio','Lighting','Accessories','Travel','Style'].map(x=>`<button data-expert-filter="${x}" aria-pressed="${expertFilter===x}">${x}</button>`).join('')}</div>`);const rs=Object.entries(RESEARCH.reviews).filter(([k])=>expertFilter==='All'||reviewCategories[k]===expertFilter);h.innerHTML=rs.map(([k,r])=>{const i=allItems().find(i=>i.review?.url===r.url)||RESEARCH.alternatives.find(i=>i.review?.url===r.url)||{};return `<article class="expert-feature reveal"><a class="expert-poster" href="${esc(r.url)}" target="_blank" rel="noopener noreferrer"><img src="${r.video?'https://i.ytimg.com/vi/'+r.video+'/hqdefault.jpg':assetFor(i.image)||sceneFor(i.cat)}" alt="${r.video?'Review video thumbnail: ':'Product image for written review: '}${esc(r.title)}" loading="lazy" referrerpolicy="no-referrer"><span class="play">${r.video?'▶ WATCH':'READ'} ↗</span></a><div class="copy"><span class="eyebrow">${reviewCategories[k]} · ${esc(r.by)}</span><h3>${esc(r.title)}</h3><p>${esc(evidenceWhy[k])}</p>${external(r.url,r.video?'Watch the original':'Read the original')}<p class="note">Independent evidence. No MissionMed endorsement.</p></div></article>`;}).join('');if(expertFilter==='Style')h.innerHTML=`<article class="paper" style="grid-column:1/-1"><h3>Fit before a product review.</h3><p>Our style guidance is an editorial planning aid. We have not verified independent tests of every garment. Read the actual fabric, size and return information beside each outfit piece, then rehearse it seated and standing.</p>${external('https://students-residents.aamc.org/applying-residency/virtual-interviews-applicant-preparation-guide','AAMC virtual interview preparation')}<a class="btn plain" href="#dress">Open Style Studio →</a></article>`;document.querySelectorAll('[data-expert-filter]').forEach(b=>b.onclick=()=>{expertFilter=b.dataset.expertFilter;renderExperts();});bindEditorial(h);}
 renderPrimeDay=function(){const picks=CATALOG.online.filter(c=>['webcam','mic','light','accessories'].includes(c.id)).map(c=>[c,c.items.find(i=>i.t===c.pick&&i.asin)||c.items.find(i=>i.asin)]);document.getElementById('primeday').innerHTML=`<div class="editorial-note">Deals worth watching. No current offer or sale event has been verified. Check the exact model, return terms and complete setup before deciding.</div><div class="shopping-story">${picks.map(([c,i],n)=>`<article class="deal-feature reveal"><div class="deal-photo"><img src="${assetFor(i.image)||sceneFor(c.id)}" alt="${i.image?esc(i.name):'Preparation scene · original product photos linked'}" loading="lazy"></div><div class="deal-copy"><span class="eyebrow">0${n+1} · ${c.name} · ${tierOf(i.t).name}</span><h3>${esc(i.name)}</h3><p>${esc(i.why)}</p><p><b>Before you buy:</b> ${esc(i.setup)}</p>${reviewBlock(i)}<div class="actions">${external(amazonUrl(i),'Check current listing','btn gold sm')}<button class="btn plain sm" data-kit="${esc(i.key)}" aria-pressed="${kit.has(i.key)}">${kit.has(i.key)?'Saved ✓':'Save to kit'}</button></div></div></article>`).join('')}</div>`;bindEditorial(document.getElementById('primeday'));};
