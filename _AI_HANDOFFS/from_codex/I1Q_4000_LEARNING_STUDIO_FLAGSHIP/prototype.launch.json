{
  "schema": "missionmed.prototype-launcher",
  "schemaVersion": 1,
  "frameworkVersion": "1.0.0",
  "prototypeId": "i1q-4000-learning-studio",
  "displayName": "MissionMed Learning Studio",
  "projectDirectory": "prototype",
  "port": 3000,
  "openUrl": "http://localhost:3000/",
  "node": {
    "minimumVersion": "22.13.0"
  },
  "health": {
    "url": "http://localhost:3000/",
    "status": 200,
    "bodyIncludes": "MissionMed Learning Studio · P4 Prototype",
    "timeoutMs": 180000,
    "intervalMs": 400
  },
  "dependencies": {
    "mode": "package-manager",
    "manager": "pnpm",
    "version": "11.9.0",
    "lockfile": "pnpm-lock.yaml",
    "probes": [
      "node_modules/.modules.yaml",
      "node_modules/.bin/vinext",
      "node_modules/vinext/package.json",
      "node_modules/react/package.json",
      "node_modules/@cloudflare/vite-plugin/package.json",
      "node_modules/typescript/package.json"
    ],
    "installArgs": [
      "install",
      "--frozen-lockfile"
    ],
    "timeoutMs": 900000
  },
  "server": {
    "mode": "process",
    "tool": "packageManager",
    "args": [
      "exec",
      "vinext",
      "dev",
      "--port",
      "3000",
      "--hostname",
      "127.0.0.1"
    ],
    "environment": {
      "WRANGLER_LOG_PATH": ".wrangler/wrangler.log"
    },
    "shutdownGraceMs": 10000
  }
}
