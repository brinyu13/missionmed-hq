PRIQ_BIND=127.0.0.1
PRIQ_PORT=4310
PRIQ_ENV=development
PRIQ_AUTH_MODE=
PRIQ_FOUNDER_USER_IDS=
PRIQ_FOUNDER_EMAILS=
MMHQ_SUPABASE_URL=
SUPABASE_JWKS_URL=
OPENAI_API_KEY=
PRIQ_OPENAI_DEV_ENV_FILE=
MIR_OPENAI_RESTRICTED_DATA_APPROVED=false
MIR_ANTHROPIC_API_KEY=
MIR_LOCAL_WORKER_URL=
MIR_SEARCH_API_KEY=
MIR_DATABASE_URL=
MIR_DAILY_BUDGET_USD=8
MIR_MONTHLY_BUDGET_USD=250
MIR_TIMEOUT_MS=45000
