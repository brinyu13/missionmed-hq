<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.missionmed.timeline-renderer.staging</string>
  <key>Disabled</key>
  <true/>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>__PACKAGE_ROOT__/operator/mac-pro/worker-entrypoint.mjs</string>
    <string>--config</string>
    <string>__PACKAGE_ROOT__/operator/mac-pro/sample-config.json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PACKAGE_ROOT__</string>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOCAL_LOG_ROOT__/timeline-renderer-staging.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOCAL_LOG_ROOT__/timeline-renderer-staging.stderr.log</string>
</dict>
</plist>

