{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "missionmed://schemas/d1/timeline-artifact-409.1",
  "title": "TimelineArtifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifactId", "artifactType", "artifactSchemaVersion", "timelineDocumentId", "timelineVersionId",
    "createdByRole", "createdAt", "updatedAt", "displayName", "documentCategory", "mimeType",
    "byteSize", "contentHash", "exportScope", "visibility", "approvalState", "theme",
    "primaryFile", "companionFiles", "timelineEventCount", "warnings", "retentionClass",
    "fileVaultLinkageState", "synchronizationStatus", "synchronizationHistory", "idempotencyKey"
  ],
  "properties": {
    "artifactId": {"type": "string", "minLength": 8},
    "artifactType": {"enum": ["TIMELINE_INTERVIEWER_SAFE_PNG", "TIMELINE_FULL_STORY_PNG", "TIMELINE_PRINT_PDF", "TIMELINE_ADVISOR_PACKET_PDF", "TIMELINE_ARCHIVE", "TIMELINE_SOURCE_JSON", "TIMELINE_ACCESSIBLE_HTML"]},
    "artifactSchemaVersion": {"const": "d1-timeline-artifact-409.1"},
    "timelineDocumentId": {"type": "string"},
    "timelineVersionId": {"type": "string"},
    "studentOwnerId": {"type": ["string", "null"]},
    "createdByRole": {"enum": ["STUDENT", "ADVISOR", "ADMIN", "SYSTEM_LOCAL"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "displayName": {"type": "string"},
    "description": {"type": "string"},
    "documentCategory": {"const": "MISSION_TIMELINE"},
    "mimeType": {"type": "string"},
    "byteSize": {"type": "integer", "minimum": 0},
    "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exportScope": {"enum": ["INTERVIEWER_SAFE", "FULL_STORY", "ADVISOR_PACKET", "PRINT", "ARCHIVE", "SOURCE", "ACCESSIBLE"]},
    "visibility": {"type": "string"},
    "approvalState": {"type": "object"},
    "theme": {"type": "string"},
    "dimensions": {"type": ["object", "null"]},
    "pageCount": {"type": ["integer", "null"]},
    "previewImage": {"type": ["object", "string", "null"]},
    "primaryFile": {"type": "object"},
    "companionFiles": {"type": "array"},
    "sourceDocumentReferences": {"type": "array"},
    "timelineEventCount": {"type": "integer", "minimum": 0},
    "generatedQuestionCount": {"type": "integer", "minimum": 0},
    "advisorCommentCount": {"type": "integer", "minimum": 0},
    "warnings": {"type": "array"},
    "provenanceSummary": {"type": "object"},
    "retentionClass": {"type": "string"},
    "fileVaultLinkageState": {"type": "string"},
    "legacyVaultReference": {"type": ["object", "null"]},
    "v2VaultReference": {"type": ["object", "null"]},
    "synchronizationStatus": {"type": "string"},
    "synchronizationHistory": {"type": "array"},
    "idempotencyKey": {"type": "string"}
  }
}
