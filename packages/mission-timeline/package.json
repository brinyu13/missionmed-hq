{
  "name": "@missionmed/mission-timeline",
  "version": "500.0.0",
  "private": true,
  "type": "module",
  "description": "MissionMed Timeline Builder production service and authenticated Matrix integration",
  "scripts": {
    "build": "node scripts/build-d1-404-candidate.mjs",
    "test": "node --import tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "test:web": "node web/tests/run_d1_411b_kernel_browser.mjs",
    "test:matrix-app-mode": "node web/tests/run_d1_411_matrix_app_mode.mjs",
    "build:api": "node scripts/build-api.mjs",
    "check:api-only": "node scripts/check-api-only-build.mjs",
    "build:release": "node scripts/build-static.mjs --mode=release && node scripts/check-release.mjs && node scripts/build-wordpress-runtime.mjs",
    "build:release:local": "node scripts/build-static.mjs --mode=local && node scripts/check-release.mjs && node scripts/build-wordpress-runtime.mjs",
    "release:manage": "node scripts/manage-d1-411c-release.mjs",
    "test:411c:rls": "node scripts/run-d1-411c-rls-proof.mjs",
    "start": "node dist-api/server.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "verify": "node scripts/verify-package.mjs",
    "manifest": "node scripts/generate-release-manifest.mjs",
    "test:413:postgres": "node --import tsx scripts/run-postgres-repository-integration-413.mjs",
    "test:413:rls": "node scripts/run-postgres-lifecycle-413.mjs",
    "test:413:operator": "D1_MAC_PRO_ENVELOPE_SECRET=local-acceptance-envelope-secret D1_MAC_PRO_WORKER_SECRET=local-acceptance-worker-secret node --import tsx operator/mac-pro/acceptance-check.mjs",
    "package:413": "node scripts/build-staging-candidate-413.mjs",
    "handoff:413": "node scripts/build-handoff-413.mjs",
    "evidence": "node scripts/build-evidence.mjs",
    "handoff": "node scripts/build-handoff.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "jose": "^6.1.0",
    "pg": "^8.22.0"
  }
}
